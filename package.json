{
  "name": "lavander",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start",
    "lint": "next lint",
    "typecheck": "tsc --noEmit",
    "db:push": "prisma db push",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "tg:webhook:dev": "tsx --env-file-if-exists=.env scripts/set-webhook.ts",
    "tg:webhook:prod": "NODE_ENV=production tsx --env-file-if-exists=.env scripts/set-webhook.ts",
    "tg:webhook:revoke": "tsx --env-file-if-exists=.env scripts/revoke-webhook.ts",
    "test": "jest",
    "postinstall": "prisma generate"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@grammyjs/conversations": "^2.1.1",
    "@prisma/client": "^5.22.0",
    "cloudinary": "^2.10.0",
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "grammy": "^1.30.0",
    "next": "15.0.3",
    "react": "19.0.0-rc-66855b96-20241106",
    "react-dom": "19.0.0-rc-66855b96-20241106",
    "zod": "^3.23.8",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4.0.0-beta.4",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "jest": "^29.7.0",
    "postcss": "^8.4.49",
    "prisma": "^5.22.0",
    "tailwindcss": "^4.0.0-beta.4",
    "ts-jest": "^29.2.5",
    "tsx": "^4.19.2",
    "typescript": "^5.6.3"
  }
}
